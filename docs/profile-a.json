    "balancers": [
      {
        "tag": "balancer",
        "selector": [
          "vless-"
        ],
        "strategy": {
          "type": "leastLoad",
          "settings": {
            "expected": 5,
            "baselines": [
              "200ms",
              "500ms",
              "1000ms",
              "1500ms"
            ],
            "tolerance": 0.3
          }
        },
        "fallbackTag": "vless-01-Germany-CIDR"
