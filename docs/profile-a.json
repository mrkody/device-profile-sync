    ],
    "rules": [
      {
        "type": "field",
        "network": "tcp,udp",
        "balancerTag": "balancer"
      }
    ]
  },
  "burstObservatory": {
    "subjectSelector": [
      "vless-"
    ],
    "pingConfig": {
      "destination": "https://www.gstatic.com/generate_204",
      "interval": "20s",
      "sampling": 2,
      "timeout": "5s"
